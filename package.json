{
  "name": "drawdown-calculator",
  "homepage": "https://eljou.github.io/drawdown-calculator/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "npx @biomejs/biome format --write src",
    "lint": "npx @biomejs/biome lint --write src",
    "preview": "vite preview",
    "predeploy": "tsc -b && vite build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
